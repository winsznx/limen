{
  "name": "limen",
  "version": "0.1.0",
  "private": true,
  "description": "Prove enough. Keep the rest private. Private capital-threshold authorization on STRK20.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build && pnpm --filter @limen/web build",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "probe:mainnet": "node --experimental-strip-types tools/probe-mainnet.ts",
    "bootstrap": "./scripts/bootstrap.sh",
    "campaign": "node --experimental-strip-types scripts/generate-campaign.ts && node --experimental-strip-types scripts/run-campaign.ts",
    "verify:pool": "node --experimental-strip-types tools/verify-pool-source.ts",
    "verify:mainnet": "node --experimental-strip-types scripts/verify-mainnet.ts",
    "benchmark": "node --experimental-strip-types scripts/prover-benchmark.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@limen/protocol-config": "workspace:*",
    "@limen/sdk": "workspace:*",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "starknet": "^10.7.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  }
}
