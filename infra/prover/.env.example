# Limen Prover host configuration.
#
# Copy to .env and fill in. .env is gitignored and must never be committed.

# Starknet mainnet JSON-RPC. Must serve spec 0.10.x, and must include
# `state_diff_commitment` in block data: an endpoint on an older spec fails mid-proof
# with a message that does not mention the RPC. Alchemy's v0_10 path works.
#   https://starknet-mainnet.g.alchemy.com/starknet/version/rpc/v0_10/<YOUR_KEY>
# This URL is a credential. It is passed to the prover container at start and is never
# written into the image.
PROVER_RPC_URL=

# Bearer token every proving request must present. Generate with:
#   openssl rand -base64 32 | tr -d '\n' | tr '+/' '-_'
# The same value goes into the web app's LIMEN_GATEWAY_TOKEN secret.
GATEWAY_TOKEN=

# Cloudflare Tunnel token, from a Zero Trust tunnel whose public hostname routes to
# http://gateway:8787. The tunnel is the only inbound path to this host.
CLOUDFLARE_TUNNEL_TOKEN=

CHAIN_ID=SN_MAIN

# Loopback port the gateway is published on, for local checks.
GATEWAY_PORT=8787

# Hard memory ceiling for the prover container. Keep it a few GB below the host's
# total so an over-large proof fails fast instead of dragging the host into swap.
PROVER_MEMORY_LIMIT=24G

# One proof at a time unless the host is genuinely large. Proving is CPU-saturating,
# so a second concurrent proof usually makes both slower rather than doubling
# throughput.
PROVER_MAX_CONCURRENT=1
GATEWAY_MAX_CONCURRENT=1
GATEWAY_MAX_QUEUED=4

# Prefetching state costs one extra simulation and cuts RPC calls during the proof.
# Turn it off if the RPC endpoint is rate-limited rather than slow.
PROVER_PREFETCH_STATE=true
PROVER_CLASS_CACHE=600
PROVER_LOG_LEVEL=warn
